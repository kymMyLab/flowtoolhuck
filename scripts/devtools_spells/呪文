(async function extractFlowToolCodeFinal() {
  console.log('%c🚀 [FlowTool Code Collector V-Final] 直撃型抽出エンジン起動...', 'color: #3b82f6; font-size: 15px; font-weight: bold;');

  const targetDoc = (window.top || window).document;
  const explorer = targetDoc.querySelector('FLOW-APPLET-CODE-EXPLORER');

  if (!explorer) {
    console.error('❌ FLOW-APPLET-CODE-EXPLORER が見つかりません。画面上の「コード」タブが開かれているかご確認ください。');
    return;
  }

  const sidebar = explorer.querySelector('.code-explorer-sidebar') || explorer;
  const codeContainer = explorer.querySelector('.code-container');

  if (!codeContainer) {
    console.error('❌ エディタ枠（.code-container）が見つかりませんでした。');
    return;
  }

  // サイドバー内の全ファイルボタンを取得
  const buttons = Array.from(sidebar.querySelectorAll('button')).filter(b => {
    const t = (b.innerText || '').trim();
    return t.includes('.ts') || t.includes('.json') || t.includes('.css') || t.includes('.tsx');
  });

  console.log('%c📋 検出されたファイル一覧 (' + buttons.length + ' 件):', 'color: #8b5cf6;', buttons.map(b => b.innerText.replace(/[\r\n\s]+/g, ' ').replace(/^code\s*/i, '').trim()));

  if (buttons.length === 0) {
    console.error('❌ ファイルボタンが見つかりませんでした。');
    return;
  }

  const collected = [];
  let lastCode = '';

  for (let i = 0; i < buttons.length; i++) {
    const btn = buttons[i];
    const rawName = (btn.innerText || '').replace(/[\r\n\s]+/g, ' ').replace(/^code\s*/i, '').trim();
    console.log('%c[' + (i + 1) + '/' + buttons.length + '] クリック中: ' + rawName, 'color: #f59e0b;');

    try {
      btn.scrollIntoView({ block: 'nearest' });
      btn.click();
    } catch(e) {}

    // エディタ描画待機
    await new Promise(r => setTimeout(r, 600));

    let currentCode = (codeContainer.innerText || '').trim();

    // 直前と同じコードだった場合は切り替え待ちで追加待機
    if (currentCode === lastCode && buttons.length > 1) {
      await new Promise(r => setTimeout(r, 500));
      currentCode = (codeContainer.innerText || '').trim();
    }

    // エディタの行番号（単独の数字行: 1, 2, 3...）を除去して美しい純コードにする
    const cleanCode = currentCode.split(/\r?\n/)
      .filter(line => !/^\d+$/.test(line.trim()))
      .join('\n');

    if (cleanCode.length > 0) {
      lastCode = currentCode;
      collected.push({ name: rawName, code: cleanCode });
      console.log('%c✔ 回収成功: ' + rawName + ' (' + cleanCode.length + '文字, 行番号自動除去済)', 'color: #10b981;');
    } else {
      console.warn('%c⚠ スキップ: ' + rawName + ' (コードが空です)', 'color: #ef4444;');
    }
  }

  console.log('%c========================================', 'color: #10b981;');
  console.log('%c🎉 抽出完了！ 合計 ' + collected.length + ' / ' + buttons.length + ' ファイルのコードを取得しました', 'color: #10b981; font-size: 15px; font-weight: bold;');
  console.log('%c========================================', 'color: #10b981;');

  if (collected.length === 0) {
    console.error('❌ コードが1件も取得できませんでした。');
    return;
  }

  let fullBundleText = '// ========================================================\n';
  fullBundleText += '// Flow Tool Web Project Complete Source Dump\n';
  fullBundleText += '// Export Date: ' + new Date().toISOString() + '\n';
  fullBundleText += '// Total Files: ' + collected.length + '\n';
  fullBundleText += '// ========================================================\n\n';

  for (const file of collected) {
    fullBundleText += '/* ========================================================\n';
    fullBundleText += '   FILE: ' + file.name + '\n';
    fullBundleText += '======================================================== */\n';
    fullBundleText += file.code + '\n\n';
  }

  // ファイル自動ダウンロード
  try {
    const blob = new Blob([fullBundleText], { type: 'text/plain;charset=utf-8' });
    const a = targetDoc.createElement('a');
    a.href = URL.createObjectURL(blob);
    a.download = 'FlowTool_WebProject_Code.txt';
    targetDoc.body.appendChild(a);
    a.click();
    setTimeout(() => {
      URL.revokeObjectURL(a.href);
      a.remove();
    }, 1000);
    console.log('%c💾 [ダウンロード完了] FlowTool_WebProject_Code.txt を保存しました！', 'color: #10b981; font-weight: bold;');
  } catch(e) {}

  // クリップボード自動コピー
  try {
    if (navigator.clipboard && navigator.clipboard.writeText) {
      await navigator.clipboard.writeText(fullBundleText);
      console.log('%c📋 [クリップボード完了] 全コードをクリップボードにコピーしました！', 'color: #3b82f6; font-weight: bold;');
    }
  } catch(e) {}

  console.log('%c🎉 全作業が完了しました！ダウンロードされたファイル、またはクリップボードをご確認ください。', 'color: #10b981; font-size: 14px; font-weight: bold;');
})();